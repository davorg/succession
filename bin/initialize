#!/usr/bin/env bash
set -euo pipefail

mcp_server=${LOS_MCP:-https://lineofsuccession.co.uk};

endpoint=${LOS_MCP:-https://lineofsuccession.co.uk/mcp}

print_payload=false
while getopts ':p' option; do
  case "$option" in
    p) print_payload=true ;;
    *) echo "Usage: $0 [-p]" >&2; exit 1 ;;
  esac
done
shift "$((OPTIND - 1))"

request='{
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "protocolVersion": "2025-11-25",
      "capabilities": {},
      "clientInfo": {
        "name": "curl-test",
        "version": "1.0"
      }
    }
  }'

if "$print_payload"; then
  printf '%s\n' "$request" | jq . >&2
fi

curl -sS ${mcp_server}/mcp \
  -H 'Content-Type: application/json' \
  -H 'Accept: application/json, text/event-stream' \
  --data "$request" | jq .
